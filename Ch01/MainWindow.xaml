<Window x:Class="Ch01.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ch01"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <!-- 윈도우 전역에서 재사용할 리소스(정적 데이터) 정의 -->
    <Window.Resources>
        <!-- Car 객체 2개를 담은 MyList 컬렉션을 "cars"라는 키로 등록 -->
        <local:MyList x:Key="cars">
            <local:Car Name="임시생성차1" Make="SS"/>
            <local:Car Name="임시생성차2" Make="SS"/>
        </local:MyList>

        <!-- 단일 Car 객체를 "car"라는 키로 등록 -->
        <local:Car Name="한대차" Make="현대" x:Key="car"/>

        <!-- Style 실습: TargetType만 지정 → 암시적(implicit) 스타일. -->
        <!-- 이 창에 있는 모든 Button에 Style 속성 지정 없이도 자동 적용됨 -->
        <Style TargetType="{x:Type Button}">
            <Setter Property="Width" Value="200"/>
            <Setter Property="Background" Value="Orange"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

        <!-- Style 실습: x:Key 지정 → 명시적(explicit) 스타일. -->
        <!-- Style="{StaticResource btnStyle}"로 직접 지정한 Button에만 적용됨 -->
        <Style x:Key="btnStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="200"/>
            <Setter Property="Background" Value="LightGreen"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- 내용이 창 크기를 넘어가면 스크롤 가능하도록 감싸는 컨테이너 -->
        <ScrollViewer>
            <!-- 자식 요소들을 세로로 순서대로 배치 -->
            <StackPanel>
                <!-- 단순 텍스트 표시용 라벨 -->
                <TextBlock Text="test textblock"/>

                <!-- DataContext의 Count 값을 표시(단방향 바인딩, 편집해도 소스에 반영 안 됨) -->
                <TextBox Text="{Binding Count, Mode=OneWay}"/>

                <!-- Count 값을 0~10 범위의 슬라이더로 시각화 -->
                <Slider Maximum="10" Value="{Binding Count, Mode=OneWay}"/>

                <!-- Count 값을 진행률 표시줄로 시각화 -->
                <ProgressBar Height="20" Maximum="10" Value="{Binding Count, Mode=OneWay}"/>

                <!-- Count 값을 가로 스크롤바 형태로 시각화 -->
                <ScrollBar Maximum="10" Value="{Binding Count, Mode=OneWay}" Orientation="Horizontal" />

                <!-- DataContext 자체(CarList)를 ItemsSource로 사용하여 목록 표시 -->
                <ListBox ItemsSource="{Binding}">
                    <!-- 각 Car 항목을 "이름 + 버튼 + 제조사"가 한 줄에 나오는 형태로 표시 -->
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <TextBlock Text="{Binding Name}"/>
                                <Button Content="Click"/>
                                <TextBlock Text="{Binding Make}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 클릭 시 코드비하인드의 Button_Click 실행: CarList에 새 Car를 추가하고 -->
                <!-- ObservableCollection의 변경 알림 덕분에 위 ListBox/DataGrid가 즉시 갱신됨 -->
                <Button Click="Button_Click" Content="원소 추가">
                    <!-- Button.Template: 버튼의 "생김새"를 직접 새로 그리는 부분.
                         원래는 회색 사각형 버튼이 나오지만, 여기서는 주황색 타원 모양으로 바꿔서 보여줌.
                         (버튼을 누르면 Button_Click이 실행되는 동작 자체는 그대로 유지됨) -->
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <!-- Grid: 안에 있는 도형(타원)과 글자(ContentPresenter)를 같은 자리에 겹쳐서 배치하는 틀 -->
                            <Grid>
                                <!-- Ellipse: 버튼 배경으로 쓸 주황색 타원(알약 모양)을 그림 -->
                                <Ellipse Fill="Orange" Width="150" Height="25"/>
                                <!-- ContentPresenter: 버튼에 적힌 글자("원소 추가")를 타원 한가운데에 표시함 -->
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- 리소스에 등록한 "cars" 컬렉션을 데이터그리드로 표시 -->
                <DataGrid ItemsSource="{Binding Source={StaticResource cars}}"/>

                <!-- Style 실습: 암시적 스타일 / 명시적 스타일 / 인라인 스타일 비교 -->
                <Grid>
                    <StackPanel>
                        <!-- Width를 직접 지정하면 암시적 스타일의 Width Setter보다 우선 적용됨(Background/Padding은 스타일값 유지) -->
                        <Button Content="Click1" Width="100"/>
                        <Button Content="Click2" Width="100"/>
                        <!-- 아무 것도 지정하지 않으면 암시적 스타일(Width=200, Orange)이 그대로 적용됨 -->
                        <Button Content="Click3"/>
                        <!-- 명시적 스타일(btnStyle)을 Style 속성으로 지정 -->
                        <Button Content="Click4" Style="{StaticResource btnStyle}"/>
                        <Button Content="Click5" Style="{StaticResource btnStyle}"/>
                        <!-- Button.Style 안에 스타일을 직접 정의(인라인)하면 리소스의 스타일보다 우선 적용됨 -->
                        <Button Content="Click6">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}">
                                    <Setter Property="Width" Value="300"/>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>