<Window x:Class="Ch03.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ch03"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <!-- 바인딩 없이 고정 텍스트만 -->
            <GroupBox Header="BindData1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Hello!"></TextBlock>
                    <Button Content="Click"></Button>
                    <TextBlock Text="100"></TextBlock>
                </StackPanel>
            </GroupBox>
            <!-- 창 DataContext(코드비하인드의 bd) 사용 -->
            <GroupBox Header="BindData2">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding DataStr}" ></TextBlock>
                    <Button Background="Pink" Content="Click"></Button>
                    <TextBox Text="{Binding Path=DataInt}"></TextBox>
                </StackPanel>
            </GroupBox>
            <!-- GroupBox 자체에 DataContext를 따로 지정 -->
            <GroupBox Header="BindData3" >
                <GroupBox.DataContext>
                    <local:BindData DataStr="Hi~" DataInt="500"/>
                </GroupBox.DataContext>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding DataStr}" ></TextBlock>
                    <Button Background="Pink" Content="Click"></Button>
                    <TextBox Text="{Binding Path=DataInt}"></TextBox>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="BindData4" >

                <StackPanel Orientation="Horizontal">
                    <!-- 창 DataContext 사용 -->
                    <TextBlock Text="{Binding DataStr}" ></TextBlock>
                    <Button Background="Pink" Content="Click"></Button>
                    <TextBox Text="{Binding Path=DataInt}">
                        <!-- TextBox만 자기 DataContext로 덮어씀 -->
                        <TextBox.DataContext>
                            <local:BindData DataStr="ABCD" DataInt="-10"/>
                        </TextBox.DataContext>
                    </TextBox>
                </StackPanel>
            </GroupBox>
        </StackPanel>
        <!-- Person 바인딩되는 이름/전화 입력 폼 -->
        <StackPanel Name="panel" Grid.Row="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="5" Orientation="Horizontal">
                    <Label >이름(_N):</Label>
                    <TextBox Text="{Binding Path=Name}" Width="120"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="5" Orientation="Horizontal">
                    <Label >전화(_P):</Label>
                    <TextBox Text="{Binding Path=Phone}" Width="120"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
